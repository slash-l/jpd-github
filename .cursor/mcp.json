{
	"mcpServers": {
		"jfrog-sast-mcp": {
			"type": "stdio",
			"command": "jf",
			"args": [
				"source-mcp",
				"${workspaceFolder}"
			]
		},
		"JFrogMCPGateway": {
			"command": "jf",
			"type": "stdio",
			"args": ["mcp-gateway", "run"],
			"env": {
				"JFROG_CLI_INSECURE_TLS": "true"
			}
		}
	}
}
